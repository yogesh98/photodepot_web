{
  "name": "photodepot_web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/pages-assets.mjs check public && next build --webpack && node scripts/pages-assets.mjs prepare",
    "start": "wrangler pages dev out",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "preview": "pnpm build && wrangler pages dev out",
    "functions:build": "wrangler pages functions build --outdir .wrangler/functions --compatibility-date 2026-10-08 --compatibility-flags nodejs_compat",
    "cf:login": "wrangler login --scopes account:read user:read workers:write d1:write pages:write zone:read",
    "cf:setup": "node scripts/cloudflare.mjs setup",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "waitlist:export": "wrangler d1 execute DB --remote --command \"SELECT * FROM waitlist ORDER BY id\" --json",
    "downloads:upload": "node scripts/cloudflare.mjs upload",
    "downloads:upload:local": "node scripts/cloudflare.mjs upload --local",
    "deploy": "pnpm build && pnpm functions:build && node scripts/cloudflare.mjs deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@workos-inc/node": "^11.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^13.4.6",
    "iron-session": "^9.0.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.49.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "wheel-gestures": "^2.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261008.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "jsonc-parser": "^3.3.1",
    "miniflare": "5.20261006.1-alpha",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.149.0"
  }
}
