[Unit]
Description=Photodepot production website
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=photodepot
Group=photodepot
WorkingDirectory=/srv/photodepot/app
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
EnvironmentFile=/srv/photodepot/.env
ExecStart=/opt/photodepot-node/bin/node /srv/photodepot/app/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/photodepot /srv/photodepot/app/.next

[Install]
WantedBy=multi-user.target
